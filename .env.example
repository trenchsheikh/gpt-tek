# Generate with: openssl rand -base64 32
AUTH_SECRET=
AUTH_URL=http://localhost:3000
DATABASE_URL=
# Registered OpenAI website client. Callback: /api/auth/callback/openai
OPENAI_CLIENT_ID=
OPENAI_CLIENT_SECRET=
# Optional server key. Users may instead supply a key in Settings.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
# Keep server + public RPC on the same cluster. Default is test SOL.
SOLANA_RPC_URL=https://api.devnet.solana.com
NEXT_PUBLIC_SOLANA_RPC_URL=https://api.devnet.solana.com
NEXT_PUBLIC_SOLANA_NETWORK=devnet
